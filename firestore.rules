rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Usuarios collection - qualquer usuário autenticado pode ler e escrever
    // (o sistema gerencia permissões internamente)
    match /usuarios/{userId} {
      allow read, write: if isAuthenticated();
    }
    
    // Estoque global - qualquer usuário autenticado pode ler e escrever
    match /estoque/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    // Histórico global - qualquer usuário autenticado pode ler e escrever
    match /historico/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    // Receitas globais - qualquer usuário autenticado pode ler e escrever
    match /receitas/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    // User-specific data (legado - para compatibilidade)
    match /users/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
